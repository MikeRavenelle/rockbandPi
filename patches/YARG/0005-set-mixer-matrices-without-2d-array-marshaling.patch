--- a/Assets/Script/Audio/Bass/BassStemMixer.cs
+++ b/Assets/Script/Audio/Bass/BassStemMixer.cs
@@ -504,7 +504,7 @@
                     continue;
                 }
 
-                if (!BassMix.ChannelSetMatrix(streamHandles.Stream, volumeMatrix) || !BassMix.ChannelSetMatrix(reverbHandles.Stream, volumeMatrix))
+                if (!BassHelpers.SetMixerMatrix(streamHandles.Stream, volumeMatrix) || !BassHelpers.SetMixerMatrix(reverbHandles.Stream, volumeMatrix))
                 {
                     YargLogger.LogFormatError("Failed to set {0} matrices: {1}!", stem, Bass.LastError);
                     return false;
