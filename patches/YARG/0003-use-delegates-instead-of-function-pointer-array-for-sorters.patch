From: rockbandPi
Subject: [PATCH] Use delegates instead of a function pointer array for sorters

IL2CPP (Unity 6000.3) crashes with a NullReferenceException in
Inflater.InflateType while converting SongSorting, because of its static
array of function pointers with generic parameters
(delegate*<SongCache, SortedSongs, void>[]). Mono handles it, so official
builds never hit this. Use an Action<,>[] instead; it is only called once
per sort, so the delegate overhead doesn't matter.
---
diff --git a/Assets/Script/Menu/MusicLibrary/SongSorting.cs b/Assets/Script/Menu/MusicLibrary/SongSorting.cs
index 040c4ac2..c480cb06 100644
--- a/Assets/Script/Menu/MusicLibrary/SongSorting.cs
+++ b/Assets/Script/Menu/MusicLibrary/SongSorting.cs
@@ -1,4 +1,5 @@
-﻿using System.Collections.Generic;
+﻿using System;
+using System.Collections.Generic;
 using System.Threading.Tasks;
 using YARG.Core;
 using YARG.Core.Extensions;
@@ -151,14 +152,16 @@ namespace YARG.Menu.MusicLibrary
             }
         }
 
-        private static readonly unsafe delegate*<SongCache, SortedSongs, void>[] SORTERS =
+        // Delegates rather than function pointers: IL2CPP crashes on arrays of
+        // function pointers with generic parameters
+        private static readonly Action<SongCache, SortedSongs>[] SORTERS =
         {
-            &SortByTitle,    &SortByArtist,   &SortByAlbum,  &SortByGenre,       &SortBySubgenre,   &SortByYear,
-            &SortByCharter,  &SortByPlaylist, &SortBySource, &SortByArtistAlbum, &SortByLength,     &SortByDateAdded,
-            &SortByInstruments
+            SortByTitle,    SortByArtist,   SortByAlbum,  SortByGenre,       SortBySubgenre,   SortByYear,
+            SortByCharter,  SortByPlaylist, SortBySource, SortByArtistAlbum, SortByLength,     SortByDateAdded,
+            SortByInstruments
         };
 
-        internal static unsafe void SortEntries(SongCache cache, SortedSongs sorted)
+        internal static void SortEntries(SongCache cache, SortedSongs sorted)
         {
             sorted.Clear();
             Parallel.For(0, SORTERS.Length, i => SORTERS[i](cache, sorted));
