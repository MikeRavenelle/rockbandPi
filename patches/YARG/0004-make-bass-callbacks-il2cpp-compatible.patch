diff --git a/Assets/Script/Audio/Bass/BassStreamProcedures.cs b/Assets/Script/Audio/Bass/BassStreamProcedures.cs
index 6aaafea9..7027cc86 100644
--- a/Assets/Script/Audio/Bass/BassStreamProcedures.cs
+++ b/Assets/Script/Audio/Bass/BassStreamProcedures.cs
@@ -1,50 +1,106 @@
 ﻿using System;
 using System.IO;
+using System.Runtime.InteropServices;
+using System.Threading;
+using AOT;
 using ManagedBass;
 
 namespace YARG.Audio.BASS
 {
+    // BASS calls these from native code. IL2CPP can only marshal delegates to
+    // static methods marked [MonoPInvokeCallback], so the callbacks are static
+    // and find their stream through the user pointer (a GCHandle to this object).
+    // Pass User to Bass.CreateStream along with this object.
     public class BassStreamProcedures : FileProcedures
     {
+        private static readonly FileCloseProcedure  CloseProc  = CloseCallback;
+        private static readonly FileLengthProcedure LengthProc = LengthCallback;
+        private static readonly FileReadProcedure   ReadProc   = ReadCallback;
+        private static readonly FileSeekProcedure   SeekProc   = SeekCallback;
+
         private readonly Stream _stream;
         private readonly long _start;
         private readonly long _length;
 
+        private GCHandle _handle;
+        private int _released;
+
+        public IntPtr User => GCHandle.ToIntPtr(_handle);
+
         public BassStreamProcedures(Stream stream)
         {
             _stream = stream;
             _start = stream.Position;
             _length = stream.Length - _start;
+            _handle = GCHandle.Alloc(this);
+
+            Close = CloseProc;
+            Length = LengthProc;
+            Read = ReadProc;
+            Seek = SeekProc;
+        }
 
-            Close = (IntPtr) => _stream.Close();
-            Length = (IntPtr) => _length;
-            Read = (IntPtr Buffer, int Length, IntPtr User) =>
+        /// <summary>
+        /// Closes the stream and frees the user pointer. BASS calls this when the
+        /// stream is freed; call it yourself if creating the BASS stream failed.
+        /// </summary>
+        public void Release()
+        {
+            if (Interlocked.Exchange(ref _released, 1) != 0)
             {
-                try
-                {
-                    unsafe
-                    {
-                        return _stream.Read(new Span<byte>((byte*) Buffer, Length));
-                    }
-                }
-                catch
-                {
-                    return 0;
-                }
-            };
+                return;
+            }
+
+            _stream.Close();
+            _handle.Free();
+        }
+
+        private static BassStreamProcedures FromUser(IntPtr user)
+        {
+            return (BassStreamProcedures) GCHandle.FromIntPtr(user).Target;
+        }
 
-            Seek = (long Offset, IntPtr User) =>
+        [MonoPInvokeCallback(typeof(FileCloseProcedure))]
+        private static void CloseCallback(IntPtr user)
+        {
+            FromUser(user).Release();
+        }
+
+        [MonoPInvokeCallback(typeof(FileLengthProcedure))]
+        private static long LengthCallback(IntPtr user)
+        {
+            return FromUser(user)._length;
+        }
+
+        [MonoPInvokeCallback(typeof(FileReadProcedure))]
+        private static int ReadCallback(IntPtr buffer, int length, IntPtr user)
+        {
+            try
             {
-                try
+                unsafe
                 {
-                    _stream.Seek(Offset + _start, SeekOrigin.Begin);
-                    return true;
+                    return FromUser(user)._stream.Read(new Span<byte>((byte*) buffer, length));
                 }
-                catch
-                {
-                    return false;
-                }
-            };
+            }
+            catch
+            {
+                return 0;
+            }
+        }
+
+        [MonoPInvokeCallback(typeof(FileSeekProcedure))]
+        private static bool SeekCallback(long offset, IntPtr user)
+        {
+            try
+            {
+                var procedures = FromUser(user);
+                procedures._stream.Seek(offset + procedures._start, SeekOrigin.Begin);
+                return true;
+            }
+            catch
+            {
+                return false;
+            }
         }
     }
 }
