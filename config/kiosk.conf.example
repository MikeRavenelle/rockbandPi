# Copy to config/kiosk.conf and edit. config/kiosk.conf is git-ignored.

# --- System ------------------------------------------------------------------
HOSTNAME=rockband
KIOSK_USER=rockband
# SSH is always enabled: ssh <KIOSK_USER>@<HOSTNAME>.local
# This password is used for SSH, the console, sudo and the "songs" network
# share. Change it.
KIOSK_PASSWORD=rockband
# Optional SSH public key for the kiosk user, e.g. "ssh-ed25519 AAAA... me@pc"
SSH_PUBKEY=""

LOCALE=en_US.UTF-8
TIMEZONE=America/New_York
KEYBOARD_LAYOUT="English (US)"
KEYBOARD_KEYMAP=us
# Two-letter country code for Wi-Fi regulatory settings
WIFI_COUNTRY=US

# --- Network (optional; wired Ethernet works without this) --------------------
WIFI_SSID=""
WIFI_PSK=""

# --- Display -------------------------------------------------------------------
# Display mode the Pi drives the TV at (60 Hz); YARG runs full screen at this
# size and the TV scales it up. 4K is far too heavy for the Pi's GPU. Examples:
# 1280x720, 1920x1080, or "native" for the TV's own mode. 1280x720 keeps songs
# above 60 FPS on a Pi 5. Change it later with DISPLAY_MODE in
# /etc/rockband-kiosk/kiosk.conf on the Pi.
YARG_RESOLUTION=1280x720
# Highway render resolution as a fraction of the display mode, 0.5 to 1. Lower
# is faster but blurrier; menus and the HUD stay sharp. Needs YARG_SOURCE=local.
YARG_HIGHWAY_SCALE=0.75

# --- YARG ----------------------------------------------------------------------
# Where the image's YARG comes from:
#   release  the official Linux x86_64 release below (Mono)
#   local    your own IL2CPP build from scripts/build-yarg.sh (build/yarg/player),
#            compiled ahead of time so it runs faster under emulation
YARG_SOURCE=release
# Pinned release and its SHA-256 (from the downloaded Linux-x86_64 zip)
YARG_VERSION=v0.15.0
YARG_SHA256=a13bf5372096a920b6de98c7be299c864df6673b85d4c552f13fb2ea611917ca
