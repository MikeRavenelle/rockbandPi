# Scripts run on the Pi or under bash must keep LF line endings, even on Windows
*.sh        text eol=lf
*.py        text eol=lf
*.patch     text eol=lf
*.conf      text eol=lf
*.rules     text eol=lf
*.service   text eol=lf
*.env       text eol=lf
*.example   text eol=lf
bridge/rb-bridge                text eol=lf
image/stage-rockband/**         text eol=lf
rootfs/**                       text eol=lf
# PowerShell is happiest with CRLF
*.ps1       text eol=crlf
